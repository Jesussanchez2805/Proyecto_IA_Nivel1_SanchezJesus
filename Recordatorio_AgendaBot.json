    {
      "parameters": {
        "jsCode": "/**\n * AGENDABOT — RESUMEN DIARIO (FASE 7)\n * Nodo: Code — Modo: \"Run Once for All Items\"\n * Se ejecuta después de dos nodos Google Sheets:\n *   \"Get Citas Hoy\"  (CITAS filtrado por fecha = hoy)\n *   \"Get Tareas Hoy\" (TAREAS filtrado por fecha_objetivo = hoy)\n * y antes de \"Get Usuarios Activos\" (USUARIOS filtrado por permitido = TRUE),\n * que se usa para saber a quién enviarle el resumen.\n *\n * Salida: un item POR CADA usuario a notificar, con chat_id y el texto armado,\n * listo para conectarse directo a un nodo Telegram \"Send Message\" con\n * Chat ID = {{$json.chat_id}}.\n */\n\nfunction hoyISO() {\n  return new Date().toISOString().slice(0, 10);\n}\n\nconst citasHoy = $('Get Citas Hoy').all();\nconst tareasHoy = $('Get Tareas Hoy').all();\nconst usuarios = $('Get Usuarios Activos').all();\n\nlet cuerpo = `☀️ *Resumen del día — ${hoyISO()}*\\n\\n`;\n\nif (citasHoy.length === 0) {\n  cuerpo += '📅 No tienes citas hoy.\\n\\n';\n} else {\n  cuerpo += '📅 *Citas de hoy:*\\n';\n  cuerpo += citasHoy\n    .sort((a, b) => String(a.json.hora).localeCompare(String(b.json.hora)))\n    .map(c => `• ${c.json.hora} — ${c.json.nombre} (${c.json.motivo})`)\n    .join('\\n');\n  cuerpo += '\\n\\n';\n}\n\nif (tareasHoy.length === 0) {\n  cuerpo += '✅ No tienes tareas con fecha objetivo hoy.';\n} else {\n  cuerpo += '✅ *Tareas con vencimiento hoy:*\\n';\n  cuerpo += tareasHoy\n    .filter(t => String(t.json.estado).toUpperCase() !== 'COMPLETADA')\n    .map(t => `• [${t.json.prioridad}] ${t.json.titulo}`)\n    .join('\\n');\n}\n\n// Un item por usuario activo, para que el nodo Telegram \"Send Message\" itere\n// automáticamente y le envíe el resumen a cada uno.\nreturn usuarios.map(u => ({\n  json: {\n    chat_id: u.json.telegram_user,\n    resumen_texto: cuerpo,\n  },\n}));\n"
      },
